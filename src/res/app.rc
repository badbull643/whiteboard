#include <windows.h>

// App icon (generated by tools/make_icon.ps1). Id 1 = the icon Explorer and the taskbar show.
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Whiteboard - infinite canvas"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Whiteboard"
            VALUE "OriginalFilename", "Whiteboard.exe"
            VALUE "ProductName",      "Whiteboard"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
